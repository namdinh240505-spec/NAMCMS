@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container mt-4">
    <h2 class="text-primary text-uppercase">QUẢN LÝ SẢN PHẨM</h2>
    <p>Sinh viên: <b>Nguyễn Định Nam - 2123110170</b></p>

    @* --- BỘ LỌC THEO DANH MỤC --- *@
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label font-weight-bold">Lọc theo danh mục sản phẩm</label>
                    <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">-- Tất cả danh mục --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Lọc</button>
                </div>
            </form>
        </div>
    </div>

    @* --- NÚT THÊM MỚI --- *@
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">➕ Thêm sản phẩm mới</a>
    </div>

    @* --- BẢNG DANH SÁCH SẢN PHẨM --- *@
    <table class="table table-bordered table-hover">
        <thead class="table-dark text-center">
            <tr>
                <th>ID</th>
                <th>Ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th>Tồn kho</th>
                <th>Danh mục</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center">Không tìm thấy sản phẩm nào.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">@item.Id</td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" width="60" style="border-radius: 6px;" />
                            }
                            else
                            {
                                <span class="text-muted">Không có ảnh</span>
                            }
                        </td>
                        <td><b>@item.Name</b></td>
                        <td class="text-end">@item.Price.ToString("N0") VNĐ</td>
                        <td class="text-center">
                            @if (item.StockQuantity > 0)
                            {
                                <span class="badge bg-success">@item.StockQuantity</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Hết hàng</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-info text-dark">@item.Category?.Name</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">✏️ Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">🗑️ Xóa</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>