@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="container mt-4">
    <h2 class="text-primary text-uppercase">SỬA SẢN PHẨM</h2>
    <p>Sinh viên thực hiện: <b>Nguyễn Định Nam - 2123110170</b></p>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Giá (VNĐ)</label>
                    <input asp-for="Price" type="number" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Số lượng tồn kho</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Đường dẫn ảnh (URL)</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="Nhập URL hình ảnh..." />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Danh mục sản phẩm</label>
                    <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.CategoryProducts">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="CategoryProductId" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">💾 Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-secondary">↩️ Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
