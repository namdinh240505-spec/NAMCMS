@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Chi tiết bài viết";
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h2>Chi tiết bài viết</h2>
            <div class="subtitle">Xem đầy đủ thông tin bài viết</div>
        </div>
        <div style="display: flex; gap: 10px;">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-cyber btn-cyber-primary">
                <i class="fa-solid fa-pen"></i> Sửa bài viết
            </a>
            <a asp-action="Index" class="btn-cyber btn-cyber-secondary">
                <i class="fa-solid fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9 col-md-11">
            @* Ảnh bài viết *@
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="detail-hero-image">
                    <img src="@Model.ImageUrl" alt="@Model.Title" />
                </div>
            }

            @* Thông tin bài viết *@
            <div class="cyber-card" style="margin-bottom: 24px;">
                <div class="card-header-cyber">
                    <i class="fa-solid fa-circle-info"></i> Thông tin bài viết
                </div>

                <dl class="cyber-dl">
                    <dt>ID</dt>
                    <dd><span class="badge-cyber badge-cyber-info">#@Model.Id</span></dd>
                    <dt>Tiêu đề</dt>
                    <dd><b>@Model.Title</b></dd>
                    <dt>Chuyên mục</dt>
                    <dd><span class="badge-cyber badge-cyber-purple">@Model.Category?.Name</span></dd>
                    <dt>Ngày đăng</dt>
                    <dd>
                        <i class="fa-regular fa-calendar" style="color: var(--neon-cyan); margin-right: 6px;"></i>
                        @Model.CreatedDate.ToString("dd/MM/yyyy")
                    </dd>
                    <dt>Ảnh đính kèm</dt>
                    <dd>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <span class="badge-cyber badge-cyber-success">
                                <i class="fa-solid fa-check"></i> Có ảnh
                            </span>
                        }
                        else
                        {
                            <span class="badge-cyber badge-cyber-secondary">Không có ảnh</span>
                        }
                    </dd>
                </dl>
            </div>

            @* Nội dung bài viết *@
            <div class="cyber-card">
                <div class="card-header-cyber">
                    <i class="fa-solid fa-file-lines"></i> Nội dung bài viết
                </div>
                <div class="detail-content">
                    @Html.Raw(Model.Content?.Replace("\n", "<br />") ?? "<em style='color: var(--text-muted);'>Chưa có nội dung.</em>")
                </div>
            </div>

            @* Hành động *@
            <div class="cyber-form-actions">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-cyber btn-cyber-filled-primary">
                    <i class="fa-solid fa-pen"></i> Sửa bài viết
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-cyber btn-cyber-danger">
                    <i class="fa-solid fa-trash"></i> Xóa bài viết
                </a>
                <a asp-action="Index" class="btn-cyber btn-cyber-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>
