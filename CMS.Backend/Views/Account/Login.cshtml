@{
    // Layout riêng cho trang đăng nhập - không dùng sidebar
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - NamCMS</title>
    <meta name="description" content="Đăng nhập vào hệ thống quản trị NamCMS" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-deep);
            position: relative;
            overflow: hidden;
        }

        /* Animated background grid */
        .login-page::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image:
                linear-gradient(rgba(0, 240, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 240, 255, 0.03) 1px, transparent 1px);
            background-size: 60px 60px;
            animation: grid-move 20s linear infinite;
        }

        @@keyframes grid-move {
            0% { transform: translate(0, 0); }
            100% { transform: translate(60px, 60px); }
        }

        /* Glowing orbs */
        .login-page::after {
            content: '';
            position: absolute;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(0, 240, 255, 0.08) 0%, transparent 70%);
            top: -100px; right: -100px;
            border-radius: 50%;
            animation: float-orb 8s ease-in-out infinite alternate;
        }

        @@keyframes float-orb {
            0% { transform: translate(0, 0); }
            100% { transform: translate(-50px, 50px); }
        }

        .login-container {
            width: 100%;
            max-width: 440px;
            padding: 20px;
            position: relative;
            z-index: 1;
            animation: fade-in 0.6s ease-out;
        }

        .login-card {
            background: rgba(18, 18, 30, 0.95);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 44px 36px;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(20px);
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--neon-cyan), var(--neon-magenta), var(--neon-yellow));
        }

        .login-brand {
            text-align: center;
            margin-bottom: 36px;
        }

        .login-brand .brand-logo {
            width: 60px; height: 60px;
            background: linear-gradient(135deg, var(--neon-cyan), var(--neon-magenta));
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem;
            font-weight: 900;
            color: #fff;
            margin-bottom: 16px;
            box-shadow: 0 0 30px rgba(0, 240, 255, 0.3), 0 0 60px rgba(255, 45, 123, 0.15);
        }

        .login-brand h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.6rem;
            font-weight: 900;
            margin: 0;
            background: linear-gradient(135deg, var(--neon-cyan), var(--neon-magenta));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 4px;
        }

        .login-brand p {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin: 8px 0 0;
            letter-spacing: 1px;
        }

        .login-error {
            background: rgba(255, 45, 123, 0.1);
            border: 1px solid rgba(255, 45, 123, 0.3);
            border-radius: var(--radius-sm);
            padding: 12px 16px;
            margin-bottom: 20px;
            color: var(--neon-magenta);
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: shake 0.4s ease-in-out;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            75% { transform: translateX(8px); }
        }

        .login-input-group {
            margin-bottom: 22px;
            position: relative;
        }

        .login-input-group .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 0.9rem;
            transition: all 0.3s ease;
            z-index: 1;
        }

        .login-input-group .cyber-input {
            padding-left: 42px;
        }

        .login-input-group .cyber-input:focus + .input-icon,
        .login-input-group .cyber-input:focus ~ .input-icon {
            color: var(--neon-cyan);
            text-shadow: 0 0 8px var(--neon-cyan);
        }

        .login-btn {
            width: 100%;
            padding: 14px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.85rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 3px;
            background: linear-gradient(135deg, var(--neon-cyan), #0088cc);
            color: #000;
            border: none;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 240, 255, 0.4), 0 0 40px rgba(0, 240, 255, 0.2);
        }

        .login-btn:active {
            transform: translateY(0);
        }

        .login-footer {
            text-align: center;
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
            color: var(--text-muted);
            font-size: 0.72rem;
            font-family: 'Orbitron', sans-serif;
            letter-spacing: 1px;
        }

        .login-footer .status-dot {
            display: inline-block;
            width: 6px; height: 6px;
            background: var(--neon-green);
            border-radius: 50%;
            margin-right: 6px;
            box-shadow: 0 0 8px var(--neon-green);
            animation: pulse-glow 2s infinite;
        }
    </style>
</head>
<body>
    <div class="login-page">
        <div class="login-container">
            <div class="login-card">
                @* Brand *@
                <div class="login-brand">
                    <div class="brand-logo">N</div>
                    <h1>NAMCMS</h1>
                    <p>Hệ thống quản trị nội dung</p>
                </div>

                @* Error Message *@
                @if (ViewData["Error"] != null)
                {
                    <div class="login-error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        @ViewData["Error"]
                    </div>
                }

                @* Login Form *@
                <form method="post" asp-action="Login" asp-controller="Account">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="login-input-group">
                        <label class="cyber-label">Tên đăng nhập</label>
                        <div style="position: relative;">
                            <input type="text" name="username" class="cyber-input"
                                   placeholder="Nhập tên đăng nhập..." autofocus autocomplete="username" />
                            <i class="fa-solid fa-user input-icon"></i>
                        </div>
                    </div>

                    <div class="login-input-group">
                        <label class="cyber-label">Mật khẩu</label>
                        <div style="position: relative;">
                            <input type="password" name="password" class="cyber-input"
                                   placeholder="Nhập mật khẩu..." autocomplete="current-password" />
                            <i class="fa-solid fa-lock input-icon"></i>
                        </div>
                    </div>

                    <button type="submit" class="login-btn">
                        <i class="fa-solid fa-right-to-bracket"></i>&nbsp;&nbsp;Đăng nhập
                    </button>
                </form>

                @* Footer *@
                <div class="login-footer">
                    <span class="status-dot"></span> SYSTEM ONLINE
                    <br />
                    <small>v2.0 // Nguyễn Định Nam - 2123110170</small>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
