@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Xóa banner";
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h2>Xác nhận xóa banner</h2>
            <div class="subtitle text-danger">Hành động này không thể hoàn tác! Bạn có chắc chắn muốn xóa banner này?</div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="cyber-form-container border border-danger">
                <div class="mb-4 text-center">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Title" style="max-width: 100%; max-height: 200px; border-radius: 6px; border: 1px solid var(--border-color, #ccc); margin-bottom: 20px;" />
                    }
                    <h3 class="text-white">@Model.Title</h3>
                    <p class="text-muted">Vị trí: <span class="badge bg-secondary">@Model.Position</span></p>
                </div>

                <div class="d-flex justify-content-center" style="gap: var(--space-4);">
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn-cyber btn-cyber-danger">
                            <i class="fa-solid fa-trash"></i> Xác nhận xóa
                        </button>
                    </form>
                    <a asp-action="Index" class="btn-cyber btn-cyber-secondary">
                        <i class="fa-solid fa-xmark"></i> Hủy bỏ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
