@model IEnumerable<CMS.Data.Entities.Banner>

@{
    ViewData["Title"] = "Quản lý Banner";
    var homeHeroBanners = Model.Where(b => b.Position == "HomeHero" && b.IsActive).OrderBy(b => b.SortOrder).ToList();
    var allBanners = Model.ToList();
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h2>Quản lý Banner</h2>
            <div class="subtitle">Thiết lập slideshow toàn màn hình cho trang chủ (kiểu Vans)</div>
        </div>
        <a asp-action="Create" class="btn-cyber btn-cyber-success">
            <i class="fa-solid fa-plus"></i> Thêm banner mới
        </a>
    </div>

    @* ===== SLIDESHOW PREVIEW ===== *@
    @if (homeHeroBanners.Any())
    {
        <div style="margin-bottom: 2rem;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                <i class="fa-solid fa-tv" style="color: var(--accent-primary, #00f0ff); font-size: 1.1rem;"></i>
                <span style="font-weight: 700; font-size: 1rem; color: var(--text-primary, #e0e0e0);">
                    Xem trước Slideshow trang chủ
                </span>
                <span class="badge bg-info" style="font-size: 0.75rem;">@homeHeroBanners.Count slide • Chuyển mỗi 5 giây</span>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px;">
                @for (int i = 0; i < homeHeroBanners.Count; i++)
                {
                    var b = homeHeroBanners[i];
                    <div style="position: relative; border-radius: 8px; overflow: hidden; border: 2px solid var(--border-color, #333); aspect-ratio: 16/9; background: #111;">
                        @if (!string.IsNullOrEmpty(b.ImageUrl))
                        {
                            <img src="@b.ImageUrl" alt="@b.Title"
                                 style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #1a1a2e, #16213e); display: flex; align-items: center; justify-content: center;">
                                <i class="fa-solid fa-image" style="font-size: 2rem; color: #555;"></i>
                            </div>
                        }
                        @* Overlay with slide info *@
                        <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%); display: flex; flex-direction: column; justify-content: flex-end; padding: 16px;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                                <span class="badge bg-warning text-dark" style="font-size: 0.7rem;">Slide @(i + 1)</span>
                                @if (b.IsActive)
                                {
                                    <span class="badge bg-success" style="font-size: 0.65rem;">Đang hiển thị</span>
                                }
                            </div>
                            <div style="color: #fff; font-weight: 800; font-size: 1.1rem; line-height: 1.2; text-shadow: 0 2px 8px rgba(0,0,0,0.5);">
                                @b.Title
                            </div>
                            @if (!string.IsNullOrEmpty(b.Description))
                            {
                                <div style="color: rgba(255,255,255,0.75); font-size: 0.8rem; margin-top: 2px;">@b.Description</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div style="background: var(--card-bg, #1a1a2e); border: 2px dashed var(--border-color, #333); border-radius: 12px; padding: 2.5rem; text-align: center; margin-bottom: 2rem;">
            <i class="fa-solid fa-panorama" style="font-size: 3rem; color: var(--accent-primary, #00f0ff); margin-bottom: 1rem; display: block;"></i>
            <h4 style="color: var(--text-primary, #e0e0e0); margin-bottom: 0.5rem;">Chưa có banner nào cho Slideshow</h4>
            <p style="color: var(--text-muted, #888); font-size: 0.9rem; margin-bottom: 1.5rem;">
                Thêm ít nhất <strong>3 banner</strong> với vị trí <strong>"Home Hero"</strong> để tạo slideshow toàn màn hình ấn tượng cho trang chủ.
            </p>
            <a asp-action="Create" class="btn-cyber btn-cyber-filled-primary">
                <i class="fa-solid fa-plus"></i> Thêm banner đầu tiên
            </a>
        </div>
    }

    @* ===== HƯỚNG DẪN ===== *@
    <div style="background: rgba(0, 240, 255, 0.05); border: 1px solid rgba(0, 240, 255, 0.2); border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: flex-start; gap: 12px;">
        <i class="fa-solid fa-circle-info" style="color: var(--accent-primary, #00f0ff); font-size: 1.1rem; margin-top: 2px;"></i>
        <div style="font-size: 0.85rem; color: var(--text-muted, #aaa); line-height: 1.7;">
            <strong style="color: var(--text-primary, #e0e0e0);">Lưu ý về banner toàn màn hình:</strong><br />
            • Ảnh nên có kích thước tối thiểu <strong>1920×1080px</strong> (tỷ lệ 16:9) để hiển thị đẹp trên mọi thiết bị.<br />
            • Nên sử dụng <strong>3 banner</strong> cho hiệu ứng slideshow tốt nhất. Các slide sẽ tự chuyển mỗi <strong>5 giây</strong>.<br />
            • <strong>Thứ tự hiển thị</strong> quyết định thứ tự slide (0 = đầu tiên).<br />
            • Tiêu đề và mô tả sẽ hiển thị đè lên ảnh với chữ trắng lớn, nên giữ ngắn gọn.
        </div>
    </div>

    @* ===== BẢNG DANH SÁCH ===== *@
    <div class="cyber-table-wrapper">
        <table class="cyber-table">
            <thead>
                <tr>
                    <th class="text-center" style="width: 60px;">Slide</th>
                    <th style="width: 220px;">Ảnh xem trước</th>
                    <th>Tiêu đề / Mô tả</th>
                    <th>Liên kết</th>
                    <th class="text-center" style="width: 100px;">Vị trí</th>
                    <th class="text-center" style="width: 80px;">Thứ tự</th>
                    <th class="text-center" style="width: 110px;">Trạng thái</th>
                    <th class="text-center" style="width: 180px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @{ int slideNum = 0; }
                @foreach (var item in allBanners)
                {
                    slideNum++;
                    <tr>
                        <td class="text-center">
                            <span class="badge bg-secondary" style="font-size: 0.85rem; min-width: 32px;">@slideNum</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <div style="aspect-ratio: 16/9; width: 200px; border-radius: 6px; overflow: hidden; border: 1px solid var(--border-color, #333); background: #111;">
                                    <img src="@item.ImageUrl" alt="@item.Title"
                                         style="width: 100%; height: 100%; object-fit: cover;" />
                                </div>
                            }
                            else
                            {
                                <div style="aspect-ratio: 16/9; width: 200px; border-radius: 6px; overflow: hidden; border: 1px dashed var(--border-color, #333); background: #111; display: flex; align-items: center; justify-content: center;">
                                    <span style="color: var(--text-muted, #666); font-size: 0.8rem;">Không có ảnh</span>
                                </div>
                            }
                        </td>
                        <td>
                            <div style="font-weight: 700; font-size: 1.05rem; margin-bottom: 4px;">@item.Title</div>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div style="font-size: 0.85rem; color: var(--text-muted, #777);">@item.Description</div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.LinkUrl))
                            {
                                <a href="@item.LinkUrl" target="_blank"
                                   style="color: var(--accent-primary, #00f0ff); text-decoration: underline; font-size: 0.9rem;">
                                    @item.LinkUrl
                                </a>
                            }
                            else
                            {
                                <span style="color: var(--text-muted, #666); font-size: 0.85rem;">— Không có —</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.Position == "HomeHero")
                            {
                                <span class="badge bg-primary" style="font-size: 0.75rem;">Hero</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary" style="font-size: 0.75rem; text-transform: uppercase;">@item.Position</span>
                            }
                        </td>
                        <td class="text-center" style="font-weight: 700; font-size: 1.1rem;">@item.SortOrder</td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success" style="font-size: 0.85rem; padding: 5px 12px;">
                                    <i class="fa-solid fa-eye" style="margin-right: 4px;"></i> Hiển thị
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger" style="font-size: 0.85rem; padding: 5px 12px;">
                                    <i class="fa-solid fa-eye-slash" style="margin-right: 4px;"></i> Ẩn
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-cyber btn-cyber-primary btn-cyber-sm">
                                <i class="fa-solid fa-pen"></i> Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-cyber btn-cyber-danger btn-cyber-sm">
                                <i class="fa-solid fa-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
                @if (!allBanners.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted" style="padding: var(--space-8, 2rem);">
                            Chưa có banner nào trong hệ thống. Hãy thêm mới ngay!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
