@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Thêm banner mới";
}

<div class="animate-fade-in">
    <div class="page-header">
        <div>
            <h2>Thêm banner mới</h2>
            <div class="subtitle">Tạo slide toàn màn hình cho trang chủ — Ảnh khuyên dùng: 1920×1080 trở lên</div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="cyber-form-container">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="cyber-form-group">
                        <label class="cyber-label">Tiêu đề banner <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="cyber-input" placeholder="Ví dụ: Bộ sưu tập mùa hè 2026" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                        <small class="text-muted mt-1 d-block">
                            Tiêu đề sẽ hiển thị lớn ở giữa banner. Nên ngắn gọn, 2–4 từ mỗi dòng. Dùng xuống dòng (Enter) để tách thành nhiều dòng.
                        </small>
                    </div>

                    <div class="cyber-form-group">
                        <label class="cyber-label">Mô tả ngắn (phụ đề)</label>
                        <textarea asp-for="Description" class="cyber-input" rows="2"
                                  placeholder="Ví dụ: Ưu đãi lên đến 50%"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                        <small class="text-muted mt-1 d-block">Hiển thị như badge nhỏ phía trên tiêu đề. Để trống nếu không cần.</small>
                    </div>

                    <div class="cyber-form-group">
                        <label class="cyber-label">Chọn ảnh banner <span class="text-danger">*</span></label>
                        <input type="file" name="ImageFile" accept="image/*" class="cyber-input" required
                               id="bannerImageInput" />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        <small class="text-muted mt-1 d-block">
                            <i class="fa-solid fa-circle-info" style="color: var(--accent-primary, #00f0ff);"></i>
                            <strong>Kích thước khuyên dùng: 1920×1080px</strong> (tỷ lệ 16:9) hoặc lớn hơn.
                            Ảnh sẽ được phóng to phủ kín toàn bộ màn hình.
                            Định dạng: .jpg, .png, .webp
                        </small>

                        @* Image preview *@
                        <div id="imagePreviewWrapper" style="display: none; margin-top: 12px;">
                            <label class="cyber-label" style="font-size: 0.85rem; margin-bottom: 6px;">Xem trước:</label>
                            <div style="position: relative; aspect-ratio: 16/9; max-width: 100%; border-radius: 8px; overflow: hidden; border: 2px solid var(--border-color, #333); background: #111;">
                                <img id="imagePreview" src="" alt="Preview"
                                     style="width: 100%; height: 100%; object-fit: cover;" />
                                <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0.7) 100%); display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 8px;">
                                    <span style="background: rgba(255,255,255,0.15); backdrop-filter: blur(8px); padding: 4px 16px; border-radius: 999px; font-size: 0.75rem; color: rgba(255,255,255,0.9); text-transform: uppercase; letter-spacing: 0.08em;">Mô tả sẽ hiển thị ở đây</span>
                                    <span style="color: #fff; font-size: 1.8rem; font-weight: 900; text-transform: uppercase; text-shadow: 0 2px 12px rgba(0,0,0,0.5);">TIÊU ĐỀ BANNER</span>
                                    <div style="display: flex; gap: 8px;">
                                        <span style="background: #fff; color: #111; padding: 6px 18px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Khám phá ngay →</span>
                                        <span style="border: 1px solid rgba(255,255,255,0.5); color: #fff; padding: 6px 18px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Tất cả sản phẩm</span>
                                    </div>
                                </div>
                            </div>
                            <small class="text-muted mt-1 d-block">
                                <i class="fa-solid fa-expand"></i> Ảnh này sẽ phủ kín toàn bộ viewport (100% chiều cao màn hình)
                            </small>
                        </div>
                    </div>

                    <div class="cyber-form-group">
                        <label class="cyber-label">Liên kết khi bấm nút "Khám phá"</label>
                        <input asp-for="LinkUrl" class="cyber-input" placeholder="Ví dụ: /products hoặc /products?categoryId=1" />
                        <span asp-validation-for="LinkUrl" class="text-danger"></span>
                        <small class="text-muted mt-1 d-block">Mặc định sẽ chuyển đến trang sản phẩm nếu để trống.</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="cyber-form-group">
                                <label class="cyber-label">Vị trí hiển thị</label>
                                <select asp-for="Position" class="cyber-input">
                                    <option value="HomeHero">🏠 Home Hero (Slideshow trang chủ)</option>
                                    <option value="Sidebar">📐 Sidebar (Cột phụ)</option>
                                    <option value="MiddleBanner">📄 Middle Banner (Banner giữa trang)</option>
                                </select>
                                <span asp-validation-for="Position" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="cyber-form-group">
                                <label class="cyber-label">Thứ tự slide</label>
                                <input asp-for="SortOrder" type="number" class="cyber-input" min="0"
                                       placeholder="0 = hiển thị đầu tiên" />
                                <span asp-validation-for="SortOrder" class="text-danger"></span>
                                <small class="text-muted mt-1 d-block">Slide có số nhỏ hơn sẽ hiển thị trước.</small>
                            </div>
                        </div>
                    </div>

                    <div class="cyber-form-group">
                        <div class="form-check form-switch mt-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" style="cursor: pointer;">
                            <label class="form-check-label cyber-label" for="isActiveSwitch" style="padding-left: 10px; cursor: pointer; display: inline-block;">Kích hoạt hiển thị trên website</label>
                        </div>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>

                    <div class="cyber-form-actions mt-4">
                        <button type="submit" class="btn-cyber btn-cyber-filled-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Lưu banner
                        </button>
                        <a asp-action="Index" class="btn-cyber btn-cyber-secondary">
                            <i class="fa-solid fa-arrow-left"></i> Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Live image preview
        document.getElementById('bannerImageInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            const wrapper = document.getElementById('imagePreviewWrapper');
            const preview = document.getElementById('imagePreview');

            if (file) {
                const reader = new FileReader();
                reader.onload = function (ev) {
                    preview.src = ev.target.result;
                    wrapper.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                wrapper.style.display = 'none';
            }
        });
    </script>
}
